<resources>
    <style name="Theme.CLMix" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorError">@color/mute_active</item>
    </style>

    <!-- Material 3 draws its FABs as rounded squares. The landscape
         controls toggle is meant to read as a floating dot over the
         strips, so it takes a full-circle shape instead. -->
    <style name="ShapeAppearance.CLMix.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- One choice in the SOS options dialog (layout/dialog_sos.xml):
         a full-width red button with centred text. -->
    <style name="SosOption" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="backgroundTint">@color/sos</item>
        <item name="cornerRadius">14dp</item>
    </style>
</resources>
