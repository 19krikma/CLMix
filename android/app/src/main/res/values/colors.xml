<resources>
    <!-- CLMix is dark at all times - there is no light palette, so these
         are the only colours and nothing is redefined under -night. -->
    <color name="primary">#6C93FF</color>
    <color name="on_primary">#0B1530</color>
    <color name="secondary">#3FCF8E</color>
    <color name="on_secondary">#052A18</color>

    <color name="background">#121317</color>
    <color name="surface">#1B1D22</color>
    <color name="surface_variant">#25272E</color>
    <color name="on_surface">#ECEDF0</color>
    <color name="on_surface_variant">#A9ACB4</color>

    <color name="mute_active">#FF6B62</color>
    <!-- The SOS button: loud on purpose. -->
    <color name="sos">#C62828</color>
    <color name="mute_inactive">#33363C</color>
    <color name="on_mute_inactive">#D3D6DC</color>

    <color name="track_background">#33363C</color>

    <!-- The fill of the connect screen's floating permissions button: the
         surface colour at 70%, so the wallpaper reads through it the way
         the iOS control's material does. A literal because a shape
         drawable cannot apply an alpha to ?attr/colorSurface itself. -->
    <color name="login_control_fill">#B31B1D22</color>

    <!-- The connect screen's own outline: its boxes, rows, rule, fields
         and the floating permissions button. -->
    <color name="login_outline">#FFFFFF</color>

    <!-- Outlines on the connect screen's Discovered/Manual boxes and its
         unselected server rows. -->
    <color name="outline">#FFFFFF</color>

    <!-- The EQ screen: one colour per band and one for both filters,
         kept the same on the graph's handles and on the chips that select
         them. -->
    <color name="eq_band_lf">#F07A2E</color>
    <color name="eq_band_lmf">#D9A400</color>
    <color name="eq_band_hmf">#21A870</color>
    <color name="eq_band_hf">#3B82F6</color>
    <color name="eq_filter">#9B6CF0</color>
</resources>
