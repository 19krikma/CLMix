<?xml version="1.0" encoding="utf-8"?>
<!-- Rejected-credentials state: red in every state, so both fields go red
     together rather than only whichever one currently has focus.

     Every state is listed explicitly even though they share one color,
     because TextInputLayout.setBoxStrokeColorStateList() only reads the
     per-state colors when the list reports isStateful() - given a single
     stateless item it assigns the focused color alone, and the unfocused
     field keeps its normal border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="?attr/colorError" />
    <item android:state_focused="true" android:color="?attr/colorError" />
    <item android:state_hovered="true" android:color="?attr/colorError" />
    <item android:color="?attr/colorError" />
</selector>
