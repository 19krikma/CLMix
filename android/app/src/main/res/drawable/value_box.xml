<?xml version="1.0" encoding="utf-8"?>
<!-- The little black readout beside a dial. Deliberately black in both
     palettes rather than a themed surface: it is a meter-style readout,
     the way a console prints its own values, not a panel. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0B0C0E" />
    <corners android:radius="6dp" />
    <stroke android:width="1dp" android:color="#2A2D33" />
</shape>
