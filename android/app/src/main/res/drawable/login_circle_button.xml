<!-- The connect screen's floating circular control. The fill is its own
     day/night colour rather than ?attr/colorSurface at an alpha, which a
     shape drawable cannot express: it is the surface colour let down so
     the wallpaper reads through it the way the iOS control's material
     does, and both cuts of the wallpaper need one. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/login_control_fill" />
    <stroke
        android:width="1dp"
        android:color="@color/login_outline" />
</shape>
