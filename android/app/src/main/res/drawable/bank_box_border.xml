<?xml version="1.0" encoding="utf-8"?>
<!-- The outlined box the banks sit in when a tablet puts them in the
     middle of the top bar (see LargeScreen.kt). Same corners as the
     bank buttons inside it, and the menu divider's grey rather than
     white, so it frames the buttons without competing with them. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <corners android:radius="12dp" />

    <stroke
        android:width="1dp"
        android:color="@color/divider" />

</shape>
