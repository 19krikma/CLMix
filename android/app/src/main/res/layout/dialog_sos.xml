<?xml version="1.0" encoding="utf-8"?>
<!-- The SOS options - see Sos.showOptions. Each choice is a full-width
     filled button so it reads as one at a glance, all centred. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:text="SOS - what do you need?"
        android:textColor="@color/on_surface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- One item_sos_option per message the server offers - filled in
         by Sos.showOptions. Weighted so a list too long for the screen
         (landscape, or a long custom list) shrinks and scrolls rather
         than pushing CANCEL off the bottom. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/sos_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/sos_none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:text="No SOS messages are set up on the computer."
        android:textColor="@color/on_surface"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/sos_cancel"
        style="@style/SosOption"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="0dp"
        android:text="CANCEL"
        android:textColor="@color/on_mute_inactive"
        app:backgroundTint="@color/mute_inactive" />
</LinearLayout>
