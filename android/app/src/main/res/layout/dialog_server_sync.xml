<?xml version="1.0" encoding="utf-8"?>
<!-- The "Server Syncing" cover - see ServerSync. Laid over the screen's
     own content rather than shown as a dialog, so it opens no window of
     its own: a dialog window brings a full-screen mixer's hidden system
     bars back and makes the screen behind it jump. The dim takes every
     touch. On it, a card: a spinning ring around the sync arrows, the
     title, and a line saying what is happening - first the desktop
     resyncing, then this phone pulling the new info. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:clickable="true"
    android:elevation="32dp"
    android:focusable="true">

<LinearLayout
    android:id="@+id/sync_card"
    android:layout_width="280dp"
    android:layout_gravity="center"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="24dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp">

        <com.clmix.SyncRingView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/sync_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_refresh"
            app:tint="@color/primary" />

    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Server Syncing"
        android:textColor="@color/on_surface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sync_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/on_surface_variant"
        android:textSize="14sp" />

</LinearLayout>

</FrameLayout>
