<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorSurfaceVariant"
    app:cardBackgroundColor="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        android:paddingVertical="18dp"
        android:paddingHorizontal="18dp">

        <TextView
            android:id="@+id/aux_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="17sp"
            android:textColor="?attr/colorOnSurface" />

        <!-- Who has this aux open right now (AuxUsers). Gone when nobody
             does. Capped at a share of the row so a long list of names
             never squeezes the aux's own name out. -->
        <TextView
            android:id="@+id/aux_users"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:maxWidth="180dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:gravity="end"
            android:drawablePadding="5dp"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
