<?xml version="1.0" encoding="utf-8"?>
<!-- The channel's input stage, opened from the number or name at the top
     of a Full Mixer Control strip. Gain and trim are turned with the
     dials (see DialView) rather than dragged on a slider - a console sets
     them in small deliberate steps, and a head amp is not something a
     stray swipe should move. Each dial's label sits directly over its
     readout, so the pair reads as one control. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="10dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@color/track_background" />

    <TextView
        android:id="@+id/input_channel_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:textSize="13sp"
        android:textColor="@color/on_surface_variant"
        tools:text="Channel 22" />

    <!-- The name reads as a value the console holds, like gain and trim
         below, so it wears the same readout box - and it is edited right
         there: tap it, clear it, type the new name, Done. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/input_channel_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/value_box"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:paddingHorizontal="10dp"
            android:maxLines="1"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:selectAllOnFocus="true"
            android:hint="Channel name"
            android:textColorHint="#6B7079"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#F2F4F8"
            tools:text="DI 2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/phase_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:contentDescription="Polarity"
            app:icon="@drawable/ic_phase"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="@color/on_mute_inactive"
            app:backgroundTint="@color/mute_inactive"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.CLMix.Circle" />

    </LinearLayout>

    <!-- The channel's two input slots side by side. Main / ALT at the top
         of each picks which one feeds the channel; under each sit that
         slot's own 48V and head-amp gain, and the trim - which comes after
         the switch, so the two Trim dials are one value. The ALT column
         is disabled until the console reports an alt route. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <include
            android:id="@+id/main_column"
            layout="@layout/channel_input_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp" />

        <include
            android:id="@+id/alt_column"
            layout="@layout/channel_input_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
