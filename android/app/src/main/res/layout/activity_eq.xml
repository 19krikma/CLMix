<?xml version="1.0" encoding="utf-8"?>
<!-- One channel's EQ, full screen and always landscape: the graph takes
     the width, which is what a frequency axis needs, and the selected
     band's dials sit beside it in a column. Opened from the EQ button on
     a Full Mixer Control strip. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/eq_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/colorSurface"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back to the mixer"
            android:src="@drawable/ic_chevron_left"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/channel_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="13sp"
            android:textColor="@color/on_surface_variant"
            tools:text="17" />

        <TextView
            android:id="@+id/channel_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            tools:text="Lead Vox" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="EQ"
            android:textSize="15sp"
            android:textColor="@color/on_surface_variant" />

        <TextView
            android:id="@+id/status_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/colorError"
            android:text="" />

        <!-- The whole EQ section in or out. Bypassed, the graph still
             draws the curve in grey so what switching back in would do is
             visible. The filters have their own in/out and stay put. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/eq_in_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="76dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="EQ IN"
            android:textSize="12sp"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/mute_inactive"
            android:textColor="@color/on_mute_inactive" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:padding="8dp">

        <com.clmix.EqGraphView
            android:id="@+id/eq_graph"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:contentDescription="EQ curve - drag a handle to move it, pinch to change Q" />

        <LinearLayout
            android:id="@+id/control_panel"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            android:background="?attr/colorSurface"
            android:padding="8dp">

            <!-- One chip per handle on the graph, low to high, in the
                 handle's own colour while selected. Filled in by
                 EqActivity. -->
            <LinearLayout
                android:id="@+id/target_row"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/target_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="HMF - Band 2" />

                <!-- On for a band, In for a filter - EqActivity relabels. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/target_on_button"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="64dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="ON"
                    android:textSize="12sp"
                    app:cornerRadius="10dp"
                    app:backgroundTint="@color/mute_inactive"
                    android:textColor="@color/on_mute_inactive" />

            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/freq_column"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Freq"
                        android:textSize="12sp"
                        android:textColor="@color/on_surface_variant" />

                    <com.clmix.DialView
                        android:id="@+id/freq_dial"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:contentDescription="Frequency dial - hold and drag" />

                    <TextView
                        android:id="@+id/freq_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/value_box"
                        android:gravity="center"
                        android:paddingVertical="6dp"
                        android:maxLines="1"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#F2F4F8"
                        tools:text="1.25k" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/gain_column"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Gain"
                        android:textSize="12sp"
                        android:textColor="@color/on_surface_variant" />

                    <com.clmix.DialView
                        android:id="@+id/gain_dial"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:contentDescription="Gain dial - hold and drag" />

                    <TextView
                        android:id="@+id/gain_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/value_box"
                        android:gravity="center"
                        android:paddingVertical="6dp"
                        android:maxLines="1"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#F2F4F8"
                        tools:text="+3.5 dB" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/q_column"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Q"
                        android:textSize="12sp"
                        android:textColor="@color/on_surface_variant" />

                    <com.clmix.DialView
                        android:id="@+id/q_dial"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:contentDescription="Q dial - hold and drag" />

                    <TextView
                        android:id="@+id/q_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/value_box"
                        android:gravity="center"
                        android:paddingVertical="6dp"
                        android:maxLines="1"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#F2F4F8"
                        tools:text="0.71" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
