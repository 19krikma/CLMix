<?xml version="1.0" encoding="utf-8"?>
<!-- One dial on the Dynamics screen: label, dial, readout. Inflated by
     DynamicsActivity, five to a section. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/dial_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:textSize="11sp"
        android:textColor="@color/on_surface_variant"
        tools:text="Thresh" />

    <com.clmix.DialView
        android:id="@+id/dial"
        android:layout_width="48dp"
        android:layout_height="48dp" />

    <TextView
        android:id="@+id/dial_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginHorizontal="3dp"
        android:background="@drawable/value_box"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:maxLines="1"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#F2F4F8"
        tools:text="-20.0 dB" />

</LinearLayout>
