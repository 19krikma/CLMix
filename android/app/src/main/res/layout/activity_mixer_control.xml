<?xml version="1.0" encoding="utf-8"?>
<!-- Full Mixer Control's screen. Deliberately a trimmed relative of
     activity_mixer.xml rather than a copy of it: the strips, the bank
     panel and the drawer are the same furniture, but everything that
     belongs to riding one aux send - the aux picker sheet, presets - has
     no meaning here, where the faders are the console's own. -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/mixer_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?android:attr/colorBackground">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="?attr/colorSurface"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/menu_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menu"
                android:src="@drawable/ic_menu" />

            <!-- There is no aux bar along the bottom naming what is being
                 mixed, as there is on the aux screen - so the one thing
                 that says these faders are the console's own is here. -->
            <TextView
                android:id="@+id/mode_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mixer Control"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <Space
                android:id="@+id/top_bar_spacer"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/smooth_button"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Fine"
                android:textSize="12sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="10dp"
                app:backgroundTint="@color/mute_inactive"
                android:textColor="@color/on_mute_inactive" />

            <ImageButton
                android:id="@+id/bank_toggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Show banks"
                android:src="@drawable/ic_arrow_down" />

            <TextView
                android:id="@+id/status_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="?attr/colorError"
                android:text="" />

        </LinearLayout>

        <!-- The bank picker floats over the strips rather than sitting
             above them: opening it covers the top of the faders instead
             of squeezing every one of them shorter, which leaves room for
             a whole surface's worth of banks, every layer. On a tablet it
             is moved into the top bar instead (see LargeScreen.kt). -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channel_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:clipToPadding="false"
                android:padding="10dp" />

            <com.clmix.LayeredBankPanel
                android:id="@+id/bank_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="?attr/colorSurface"
                android:elevation="8dp"
                android:paddingHorizontal="9dp"
                android:paddingTop="2dp"
                android:paddingBottom="10dp"
                android:visibility="gone" />

        </FrameLayout>

        <include
            android:id="@+id/snapshot_bar"
            layout="@layout/snapshot_bar" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/menu_content"
        android:layout_width="@dimen/side_menu_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:elevation="8dp">

        <include
            android:id="@+id/profile_header"
            layout="@layout/drawer_profile_header" />

        <include
            android:id="@+id/mode_buttons"
            layout="@layout/menu_mode_buttons" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Presets are per-aux-send, so the aux screen's Presets button
             has nothing to act on here and is deliberately absent. -->
        <!-- Log Out ends the session outright. On its own at the bottom,
             well away from Channels and AUX at the top, which only move
             between screens. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/logout_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="14dp"
            android:text="Log Out"
            app:cornerRadius="10dp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
