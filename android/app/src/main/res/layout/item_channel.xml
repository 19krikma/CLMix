<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="118dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">

    <TextView
        android:id="@+id/channel_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:maxLines="2"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />

    <LinearLayout
        android:id="@+id/fader_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.clmix.LevelRulerView
            android:id="@+id/level_ruler"
            android:layout_width="26dp"
            android:layout_height="match_parent" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <!-- layout_width is overwritten at runtime (ChannelAdapter's
                 fader_row layout listener) to match fader_row's actual
                 measured height, since that becomes this rotated view's
                 visual length - letting the fader fill all the space
                 actually available instead of a guessed fixed length. -->
            <SeekBar
                android:id="@+id/level_seek_bar"
                android:layout_width="260dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:rotation="270"
                android:max="1000"
                android:thumb="@drawable/seekbar_thumb"
                android:progressDrawable="@drawable/seekbar_track"
                android:splitTrack="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

        </FrameLayout>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pan_button"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="4dp"
        android:text="Pan"
        android:textSize="11sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="10dp"
        app:backgroundTint="@color/mute_inactive"
        android:textColor="@color/on_mute_inactive" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/mute_button"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:text="Mute"
        android:textSize="11sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="10dp"
        app:backgroundTint="@color/mute_inactive"
        android:textColor="@color/on_mute_inactive" />

</LinearLayout>
