<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="76dp"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- Two lines always, not just when a name needs them: the fader
         below takes whatever height is left, so a strip whose name wraps
         would otherwise end up with a shorter fader than its neighbours
         and a Mute button sitting at a different height along the row.
         Reserving both lines everywhere keeps the row aligned whatever
         mix of long and short names a console has. -->
    <TextView
        android:id="@+id/channel_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:minLines="2"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />

    <LinearLayout
        android:id="@+id/fader_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:clipChildren="false">

        <!-- Wider than the space it occupies: the negative end margin
             lets the tick lines run on past the ruler's own column and
             reach the fader they point at, without taking any width from
             it. Everything but the lines is transparent, so the overlap
             is invisible. -->
        <com.clmix.LevelRulerView
            android:id="@+id/level_ruler"
            android:layout_width="31dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="-5dp" />

        <!-- A fixed width, not a weight. Weighted, this column swallowed
             every spare pixel in the strip and centred the fader in the
             middle of it - which is what held the meter out at arm's
             length however the meter's own margin was set. Sized to the
             track drawn inside it; the wider touch band overflows and is
             clipped, which costs nothing visible. -->
        <!-- clipChildren=false so the thumb can draw past this column.
             The fader's touch band is wider than the column, and the
             thumb is wider than the track it rides - clipped to the
             column, its left edge came out sliced flat. Clipping is a
             drawing bound only, so letting it through costs nothing in
             layout and leaves the track's thickness alone. -->
        <FrameLayout
            android:layout_width="30dp"
            android:layout_height="match_parent"
            android:clipChildren="false">

            <!-- layout_width is overwritten at runtime (ChannelAdapter's
                 fader_row layout listener) to match fader_row's actual
                 measured height, since that becomes this rotated view's
                 visual length - letting the fader fill all the space
                 actually available instead of a guessed fixed length. -->
            <!-- The track is drawn down the middle of this view, which
                 sits centred in the column - leaving a wide transparent
                 margin between it and the dB numbers. translationX
                 nudges the whole fader toward them.

                 It has to be a translation rather than layout_gravity:
                 the rotation below spins the view about its own centre,
                 so gravity positions the 260dp-wide *unrotated* box and
                 anchoring that to the start throws the fader clean out
                 of the column. Touch tracks the translation, so the grab
                 area moves with what is drawn. -->
            <SeekBar
                android:id="@+id/level_seek_bar"
                android:layout_width="260dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:translationX="-6dp"
                android:rotation="270"
                android:max="1000"
                android:thumb="@drawable/seekbar_thumb"
                android:progressDrawable="@drawable/seekbar_track"
                android:splitTrack="false"
                android:paddingStart="14dp"
                android:paddingEnd="14dp" />

        </FrameLayout>

        <!-- Same 0..-60dB scale the console prints on its own meters,
             deliberately not the fader's -150..+10 - so it is placed
             beside the fader rather than against the ruler. -->
        <!-- A negative start margin pulls the meter back over the dead
             strip on the fader's right - the fader's touch band is far
             wider than the track drawn down the middle of it, and that
             margin was pushing the meter a long way from the fader it
             belongs to. The meter is not clickable, so touches over the
             overlap still fall through to the fader underneath. -->
        <com.clmix.ChannelMeterView
            android:id="@+id/channel_meter"
            android:layout_width="10dp"
            android:layout_height="match_parent"
            android:layout_marginStart="-8dp" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pan_button"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="4dp"
        android:text="Pan"
        android:textSize="11sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        app:cornerRadius="10dp"
        app:backgroundTint="@color/mute_inactive"
        android:textColor="@color/on_mute_inactive" />

    <!-- minWidth/padding trimmed on both buttons: Material's own 16dp of
         side padding is wider than these strips can spare, and without
         it the label wrapped to "Mu / te". -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/mute_button"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="6dp"
        android:text="MUTE"
        android:textSize="11sp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingLeft="2dp"
        android:paddingRight="2dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        app:cornerRadius="10dp"
        app:backgroundTint="@color/mute_inactive"
        android:textColor="@color/on_mute_inactive" />

</LinearLayout>
