<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- paddingBottom reserves the collapsed sheet's strip of screen.
         Done here rather than on the channel list: the sheet floats in
         the CoordinatorLayout and takes no layout height of its own, so
         without this the strips would measure themselves all the way to
         the bottom edge and put their Mute buttons underneath it. -->
    <LinearLayout
        android:id="@+id/mixer_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="@dimen/mixer_bottom_reserve"
        android:background="?android:attr/colorBackground">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="?attr/colorSurface"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/menu_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Menu"
                android:src="@drawable/ic_menu" />

            <!-- Calls the sound engineer - see Sos. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/sos_button"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="36dp"
                android:paddingHorizontal="14dp"
                android:text="SOS"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:contentDescription="SOS - call the sound engineer"
                app:cornerRadius="18dp"
                app:backgroundTint="@color/sos"
                android:textColor="@android:color/white" />

            <!-- Takes the room the bank spinner used to, so Fine and the
                 bank toggle stay pinned to the right edge. -->
            <Space
                android:id="@+id/top_bar_spacer"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/smooth_button"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="Fine"
                android:textSize="12sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="10dp"
                app:backgroundTint="@color/mute_inactive"
                android:textColor="@color/on_mute_inactive" />

            <!-- Pulls the bank panel below down. Rotates to point up
                 while it is open, so the control says which way it will
                 move rather than what it currently is. -->
            <ImageButton
                android:id="@+id/bank_toggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Show banks"
                android:src="@drawable/ic_arrow_down" />

            <TextView
                android:id="@+id/status_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="?attr/colorError"
                android:text="" />

        </LinearLayout>

        <!-- The bank picker, folded away until the toggle above is
             pressed. Sits in the column rather than floating over the
             strips: opening it pushes the faders down instead of
             covering the ones behind it, so nothing is hidden while
             choosing. -->
        <LinearLayout
            android:id="@+id/bank_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/colorSurface"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/bank_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="9dp"
                android:paddingTop="2dp" />

            <!-- Edit sits bottom right, under the grid. Only for an
                 account holding personalization - see setBankEditing. -->
            <LinearLayout
                android:id="@+id/bank_edit_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/bank_edit_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hold and drag to reorder"
                    android:textSize="12sp"
                    android:textColor="@color/on_surface_variant"
                    android:visibility="invisible" />

                <!-- Renames the selected bank. Edit mode only. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bank_rename_button"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Rename"
                    android:textSize="13sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:visibility="gone"
                    app:cornerRadius="10dp" />

                <ImageButton
                    android:id="@+id/bank_edit_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Edit banks"
                    android:src="@drawable/ic_edit" />

            </LinearLayout>

        </LinearLayout>

        <!-- baselineAligned off: left on, this row measures the channel
             list once with no height limit to find a text baseline, and
             the list lays its strips out collapsed during that pass - the
             faders then came out short in the middle of their strips. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Bank edit mode's "+" strip: shaped like a channel strip
                 and pinned ahead of the list rather than scrolled with
                 it, so it is always there however far along you are. -->
            <LinearLayout
                android:id="@+id/add_channel_tile"
                android:layout_width="68dp"
                android:layout_height="match_parent"
                android:layout_marginVertical="10dp"
                android:layout_marginStart="10dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/add_tile_background"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Add channels to this bank"
                android:visibility="gone">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_add"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Add"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channel_recycler"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:clipToPadding="false"
                android:padding="10dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Aux picker. A persistent bottom sheet rather than a dialog: the
         collapsed state IS the label naming the live mix, so the same
         strip of screen both answers "which mix is this?" and opens the
         list - by a tap or by dragging it up. It floats over the strips
         instead of pushing them, so the faders keep their positions and
         their height while choosing. -->
    <LinearLayout
        android:id="@+id/aux_sheet"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:elevation="12dp"
        app:behavior_peekHeight="@dimen/mixer_bottom_reserve"
        app:behavior_hideable="false"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <!-- The handle: arrows either side of the live aux name. Both
             point the way the sheet will travel, so they flip when it is
             open. Grey rather than accent so the name stays the thing
             the eye lands on. -->
        <LinearLayout
            android:id="@+id/aux_handle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/aux_sheet_peek"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/aux_arrow_start"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_up"
                app:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/current_aux_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:text="" />

            <ImageView
                android:id="@+id/aux_arrow_end"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_arrow_up"
                app:tint="@color/on_surface_variant" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/aux_sheet_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="32dp" />

    </LinearLayout>

    <!-- Over the aux sheet, along the very bottom: the sheet peeks by its
         handle plus this strip's height, so its handle sits just above
         it, and the open list's last row clears it by the extra bottom
         padding above. -->
    <include
        android:id="@+id/snapshot_bar"
        layout="@layout/snapshot_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/snapshot_bar_height"
        android:layout_gravity="bottom" />

    <!-- Landscape only, and all of it on the edge the selfie camera is
         on - which is the one strip of a landscape screen that was never
         going to hold a fader anyway. The bars at top and bottom fold
         away entirely with the phone on its side, so the strips get the
         whole height, and everything those bars held moves here.

         Which edge that is depends on which way the phone was turned,
         so the gravity of all three of these and the direction of the
         chevrons are set at runtime - see MixerActivity.applyOrientation. -->

    <!-- Catches the tap that closes an open panel. Under the panel and
         over the strips, so a tap anywhere on the mix dismisses it
         without also moving a fader. -->
    <View
        android:id="@+id/landscape_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/landscape_panel"
        android:layout_width="@dimen/landscape_panel_width"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:elevation="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/landscape_panel_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="8dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface_variant" />

        <!-- Holds the drawer's own content while the phone is on its
             side. Empty in portrait, where the menu lives in the
             drawer as usual. -->
        <FrameLayout
            android:id="@+id/landscape_panel_menu_host"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/landscape_panel_recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="9dp"
            android:paddingBottom="10dp" />

        <!-- The bank panel's Edit, for landscape. Shown only while the
             panel holds the banks. -->
        <LinearLayout
            android:id="@+id/landscape_bank_edit_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingBottom="6dp"
            android:visibility="gone">

            <!-- Landscape's way to the channel list: the "+" strip sits
                 at the left of the strips, right where this panel covers
                 it. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/landscape_add_channels_button"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="+ Channels"
                android:textSize="13sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:visibility="gone"
                app:cornerRadius="10dp" />

            <TextView
                android:id="@+id/landscape_bank_edit_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hold and drag to reorder"
                android:textSize="12sp"
                android:textColor="@color/on_surface_variant"
                android:visibility="invisible" />

            <!-- Renames the selected bank. Edit mode only. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/landscape_bank_rename_button"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Rename"
                android:textSize="13sp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:visibility="gone"
                app:cornerRadius="10dp" />

            <ImageButton
                android:id="@+id/landscape_bank_edit_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Edit banks"
                android:src="@drawable/ic_edit" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/landscape_sidebar"
        android:layout_width="@dimen/landscape_sidebar_width"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:elevation="12dp"
        android:gravity="center_horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/sidebar_menu_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            android:src="@drawable/ic_menu" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sidebar_sos_button"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minWidth="0dp"
            android:minHeight="32dp"
            android:paddingHorizontal="10dp"
            android:text="SOS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:contentDescription="SOS - call the sound engineer"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/sos"
            android:textColor="@android:color/white" />

        <LinearLayout
            android:id="@+id/sidebar_aux_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:paddingVertical="10dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/sidebar_aux_arrow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUX"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

        </LinearLayout>

        <!-- The whole middle of the strip, left empty on purpose: this
             is the stretch the selfie camera and its surround sit in, so
             putting a control there would be putting it under the glass.
             AUX rides up against the menu and BANK down against Fine,
             which also puts the two of them as far apart as the strip
             allows - a thumb reaching for one mid-show cannot catch the
             other. -->
        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/sidebar_bank_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/sidebar_bank_arrow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BANK"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sidebar_smooth_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="48dp"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:text="Fine"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="0dp"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/mute_inactive"
            android:textColor="@color/on_mute_inactive" />

    </LinearLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- In landscape this is lifted out of the drawer and dropped into
         the sidebar's panel instead - see MixerActivity.hostMenu. A
         DrawerLayout drawer always slides to the screen's own edge,
         which would bury the sidebar that opened it. -->
    <LinearLayout
        android:id="@+id/menu_content"
        android:layout_width="@dimen/side_menu_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="?attr/colorSurface"
        android:elevation="8dp">

        <include
            android:id="@+id/profile_header"
            layout="@layout/drawer_profile_header" />

        <include
            android:id="@+id/mode_buttons"
            layout="@layout/menu_mode_buttons" />

        <!-- The aux list used to live here; it is now the bottom sheet,
             within thumb reach instead of behind a drawer. What is left
             is the settings-ish actions that were always underneath it,
             held down at the bottom where a thumb reaches them - in the
             landscape panel just as much as in the drawer, since the
             hand holding the phone is at the bottom either way. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- The chat every phone shares with the sound engineer - see
             ChatActivity. Open to every account. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="10dp"
            android:text="Chat"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/mute_inactive"
            android:textColor="@color/on_mute_inactive" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/presets_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="10dp"
            android:text="Presets"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/mute_inactive"
            android:textColor="@color/on_mute_inactive" />

        <!-- Expands in place when presets_button is tapped, rather than
             navigating to a separate screen - this drawer is already the
             "settings-ish" area for the mixer screen, and Save/Load are
             just two more actions within it. -->
        <LinearLayout
            android:id="@+id/presets_expanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/preset_save_button"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Save"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/preset_load_button"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Load"
                app:cornerRadius="10dp" />

        </LinearLayout>

        <!-- Log Out ends the session outright. On its own at the bottom,
             well away from Channels and AUX at the top, which only move
             between screens. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/logout_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="14dp"
            android:text="Log Out"
            app:cornerRadius="10dp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
