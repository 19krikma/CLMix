<?xml version="1.0" encoding="utf-8"?>
<!-- One bank in the pull-down panel. Deliberately the same card shape as
     item_aux so the two lists of "things you switch between" read as the
     same kind of control, just sized for a grid rather than a drawer. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorSurfaceVariant"
    app:cardBackgroundColor="?attr/colorSurface">

    <TextView
        android:id="@+id/bank_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="6dp"
        android:paddingVertical="12dp"
        android:gravity="center"
        android:minLines="2"
        android:maxLines="2"
        android:ellipsize="end"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />

</com.google.android.material.card.MaterialCardView>
