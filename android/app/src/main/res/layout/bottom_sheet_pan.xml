<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="10dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@color/track_background" />

    <TextView
        android:id="@+id/pan_channel_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/pan_value_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="18dp"
        android:gravity="center"
        android:textSize="34sp"
        android:textStyle="bold"
        android:textColor="@color/primary" />

    <SeekBar
        android:id="@+id/pan_seek_bar_large"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:max="200"
        android:thumb="@drawable/seekbar_thumb"
        android:progressDrawable="@drawable/seekbar_track"
        android:splitTrack="false"
        android:paddingStart="4dp"
        android:paddingEnd="4dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/pan_center_button"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Center"
        app:cornerRadius="10dp"
        app:backgroundTint="@color/mute_inactive"
        android:textColor="@color/on_mute_inactive" />

</LinearLayout>
