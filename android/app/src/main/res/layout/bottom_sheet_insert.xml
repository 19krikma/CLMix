<?xml version="1.0" encoding="utf-8"?>
<!-- One of a channel's insert points, A or B (DiGiCo's Send A / Send B),
     opened from INS A / INS B on a Full Mixer Control strip. Two rows:
     the channel's name with the insert's in/out button beside it - as
     the input sheet pairs the name with polarity - and then the insert
     return's head amp in signal order: 48V, pad, gain. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="10dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@color/track_background" />

    <TextView
        android:id="@+id/insert_channel_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:textColor="@color/on_surface_variant"
        android:textSize="13sp"
        tools:text="Channel 22" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="18dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/insert_channel_name"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/value_box"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:textColor="#F2F4F8"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Lead Vox" />

        <!-- Puts the insert in or out: lit in the accent while it is in. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/in_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="116dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="10dp"
            app:backgroundTint="@color/mute_inactive"
            android:textColor="@color/on_mute_inactive"
            tools:text="Insert A" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/phantom_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="48V"
            android:textSize="11sp"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/mute_inactive"
            android:textColor="@color/on_mute_inactive" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pad_button"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="PAD"
            android:textSize="11sp"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/mute_inactive"
            android:textColor="@color/on_mute_inactive" />

        <com.clmix.DialView
            android:id="@+id/gain_dial"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="16dp"
            android:contentDescription="Insert gain dial - hold and drag" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:gravity="center"
                android:text="Gain"
                android:textColor="@color/on_surface_variant"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/gain_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/value_box"
                android:gravity="center"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:maxLines="1"
                android:paddingVertical="8dp"
                android:selectAllOnFocus="true"
                android:textColor="#F2F4F8"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="+20.0" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
