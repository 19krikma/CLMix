<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The EQ and Dynamics screens lock to landscape, which makes Play
         treat landscape as required and drop portrait-only devices.
         Those screens still open on such devices, just upright. -->
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false" />

    <application
        android:name=".CLMixApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.CLMix">

        <!-- uiMode is deliberately absent from every configChanges list
             below: these screens colour a lot of their views from code
             (mute/pan tints, the Fine button, discovered-server rows),
             and those only re-read the day/night colours on a rebuild.
             Handling a light/dark switch in-place would leave half the
             UI wearing the old palette - so let the framework recreate
             the activity instead, for the drawer's Dark mode switch and
             for the phone's own sunset switchover alike. -->
        <activity
            android:name=".ConnectActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden" />
        <activity
            android:name=".CustomBanksActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden" />
        <activity
            android:name=".ControlChoiceActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden" />
        <activity
            android:name=".MixerControlActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden" />
        <!-- Fixed landscape: the EQ graph's frequency axis wants the
             width. sensorLandscape so it turns either way round with the
             phone, rather than insisting on one side. -->
        <activity
            android:name=".EqActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden" />
        <!-- Landscape for the same reason as the EQ: the transfer graph
             and five dials want the width. -->
        <activity
            android:name=".DynamicsActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden" />
        <activity
            android:name=".AuxListActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden" />
        <activity
            android:name=".MixerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden" />

        <service
            android:name=".MixerConnectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- connectedDevice would be the semantically "correct" type for
                 maintaining a live link to the mixer console, but Android 14
                 requires it be paired with BLUETOOTH_CONNECT/NFC/UWB/a CDM
                 association - none of which apply here (this is a plain TCP
                 websocket) - and enforces that at startForeground() time by
                 crashing the app. specialUse is the type Android provides
                 for exactly this "doesn't fit a predefined category" case. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the websocket connection to the mixer server alive while backgrounded" />
        </service>

    </application>

</manifest>
