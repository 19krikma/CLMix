<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".CLMixApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.CLMix">

        <activity
            android:name=".ConnectActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AuxListActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboardHidden" />
        <activity
            android:name=".MixerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode|keyboardHidden" />

        <service
            android:name=".MixerConnectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- connectedDevice would be the semantically "correct" type for
                 maintaining a live link to the mixer console, but Android 14
                 requires it be paired with BLUETOOTH_CONNECT/NFC/UWB/a CDM
                 association - none of which apply here (this is a plain TCP
                 websocket) - and enforces that at startForeground() time by
                 crashing the app. specialUse is the type Android provides
                 for exactly this "doesn't fit a predefined category" case. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the websocket connection to the mixer server alive while backgrounded" />
        </service>

    </application>

</manifest>
